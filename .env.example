# ── Admin login (sementara hardcoded di env). Ganti sebelum deploy. ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Secret untuk menandatangani cookie session admin.
# Buat yang acak, minimal 32 karakter, misalnya: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ── Database (PostgreSQL: Neon / Supabase / lainnya) ──
# Kosongkan = website memakai konten default dan admin tidak bisa menyimpan.
# Neon: pakai connection string "Pooled connection" dari dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# ── Object storage S3-compatible (Neon Storage / Cloudflare R2) ──
# Kosongkan semuanya = file disimpan di ./storage/uploads (untuk development).
# Neon: Storage → buat credential. R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=assets

# Opsional. Isi hanya kalau bucket bisa diakses publik (mis. R2 + custom domain),
# tanpa garis miring di akhir. Kosong = file disajikan lewat /files/... di website ini.
S3_PUBLIC_URL=

# ── Jumlah pengikut (Admin → Bukti & pengikut) ──
# Opsional. API key YouTube Data API v3 (gratis, dari Google Cloud Console) supaya
# jumlah subscriber terbaca lebih stabil. Kosong = dibaca dari halaman channel.
YOUTUBE_API_KEY=
